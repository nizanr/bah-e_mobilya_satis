# Değerleri kendi .env dosyanıza yazın. Bu dosya gizli anahtar içermez.
MONGODB_URI=mongodb://127.0.0.1:27017/bahceni
PORT=3000
# En az 32 rastgele karakter. Üretim modunda zorunlu.
SESSION_SECRET=
# iyzico sandbox hesabından alınır. İkisi yoksa açıkça etiketli demo ödeme kullanılır.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# iyzico yönlendirmesi için dışarıdan erişilebilir HTTPS adresi
APP_URL=
